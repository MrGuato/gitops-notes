---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getCollection } from "astro:content";
import { base, isoDate, readingTime, sortPosts, sortProjects } from "../lib/site";

const posts = sortPosts(await getCollection("posts"));
const projects = sortProjects(await getCollection("projects"));
const [featured, ...rest] = posts;
const recent = rest.slice(0, 5);
const activeProjects = projects.filter((p) => p.data.status === "active").length;
---

<BaseLayout>
  <section class="page-h">
    <div>
      <div class="eyebrow">
        <span class="dot ok" aria-hidden="true"></span>
        Build log
        {featured && <span class="age">last entry {isoDate(featured.data.date)}</span>}
      </div>
      <h1>Jonathan DeLeon</h1>
      <p class="sub">
        Infrastructure and security engineer in Boston. I run a mixed-architecture k3s homelab
        managed with FluxCD and write down what I build, what breaks, and how I fixed it.
      </p>
      <SocialLinks />
    </div>
    <div class="kv-list">
      <div class="kv"><span class="k">Role</span><span class="v">Infrastructure Security Engineer</span></div>
      <div class="kv"><span class="k">Cert</span><span class="v">CISM</span></div>
      <div class="kv"><span class="k">Stack</span><span class="v">k3s / FluxCD / SOPS</span></div>
      <div class="kv"><span class="k">Handle</span><span class="v">@MrGuato</span></div>
    </div>
  </section>

  <div class="tiles">
    <div class="tile">
      <div class="t-k">Posts</div>
      <div class="t-v">{posts.length}</div>
      <div class="t-s">published through Git</div>
    </div>
    <div class="tile">
      <div class="t-k">Projects</div>
      <div class="t-v">{projects.length}</div>
      <div class="t-s">{activeProjects} active</div>
    </div>
    <div class="tile">
      <div class="t-k">Last entry</div>
      <div class="t-v">{featured ? isoDate(featured.data.date) : "none"}</div>
      <div class="t-s">{featured ? `${readingTime(featured.body)} min read` : ""}</div>
    </div>
    <div class="tile">
      <div class="t-k">Deploy</div>
      <div class="t-v">main</div>
      <div class="t-s">GitHub Pages via Actions</div>
    </div>
  </div>

  {featured && (
    <section class="section">
      <div class="sec-h">
        <h2>Latest post</h2>
        <a class="meta" href={`${base}/writing`}>All posts</a>
      </div>
      <a class="feature" href={`${base}/writing/${featured.slug}`}>
        {featured.data.hero && (
          <div class="feature-img">
            <img src={`${base}/${featured.data.hero}`} alt="" />
          </div>
        )}
        <div class="feature-body">
          <div class="post-meta">
            <time datetime={isoDate(featured.data.date)}>{isoDate(featured.data.date)}</time>
            <span>{readingTime(featured.body)} min read</span>
          </div>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
          {featured.data.tags && (
            <div class="tags">
              {featured.data.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
          <span class="read-more">Read post</span>
        </div>
      </a>
    </section>
  )}

  {recent.length > 0 && (
    <section class="section">
      <div class="sec-h">
        <h2>Recent writing</h2>
        <span class="meta">{posts.length} posts</span>
      </div>
      <div class="list">
        {recent.map((p) => <PostRow post={p} />)}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section">
      <div class="sec-h">
        <h2>Projects</h2>
        <a class="meta" href={`${base}/projects`}>All projects</a>
      </div>
      <div class="projects">
        {projects.slice(0, 4).map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
