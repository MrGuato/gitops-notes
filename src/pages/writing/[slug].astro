---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { getCollection } from "astro:content";
import { base, isoDate, readingTime, site, sortPosts } from "../../lib/site";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();
const heroSrc = post.data.hero ? `${base}/${post.data.hero}` : null;
const tags = post.data.tags ?? [];
const date = isoDate(post.data.date);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <div class="crumb">
      <a href={`${base}/writing`}>Writing</a>
      <span aria-hidden="true">/</span>
      <span>{date}</span>
    </div>

    <header class="post-head">
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a href={`${base}/writing?tag=${tag}`} class="tag">{tag}</a>)}
        </div>
      )}
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={date}>{date}</time>
        <span>{readingTime(post.body)} min read</span>
        <span>{site.author}</span>
      </div>
    </header>

    {heroSrc && <img class="hero" src={heroSrc} alt="" />}

    <div class="prose">
      <Content />
    </div>

    <aside class="author">
      <img src={`${base}/avatar.png`} alt="" width="48" height="48" />
      <div>
        <b>{site.author} <span class="handle">@{site.handle}</span></b>
        <p>
          Infrastructure and security engineer in Boston. Building production-minded
          infrastructure at home with a security-first mindset. {site.motto}
        </p>
        <SocialLinks />
      </div>
    </aside>

    <nav class="post-nav" aria-label="Adjacent posts">
      {older ? (
        <a class="prev" href={`${base}/writing/${older.slug}`}>
          <small>Older</small>
          <span>{older.data.title}</span>
        </a>
      ) : (
        <div></div>
      )}
      {newer ? (
        <a class="next" href={`${base}/writing/${newer.slug}`}>
          <small>Newer</small>
          <span>{newer.data.title}</span>
        </a>
      ) : (
        <div></div>
      )}
    </nav>
  </article>
</BaseLayout>
