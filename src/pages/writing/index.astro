---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getCollection } from "astro:content";
import { sortPosts } from "../../lib/site";

const posts = sortPosts(await getCollection("posts"));
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const description = "All build logs, post-mortems and notes, published through Git.";
---

<BaseLayout title="Writing" description={description}>
  <section class="page-h">
    <div>
      <div class="eyebrow">
        Writing
        <span class="age">{posts.length} posts</span>
      </div>
      <h1>All posts</h1>
      <p class="sub">{description} Filter by tag or read from the top.</p>
    </div>
  </section>

  <div class="filters" role="group" aria-label="Filter by tag">
    <button type="button" class="filter on" data-tag="all" aria-pressed="true">All</button>
    {allTags.map((tag) => (
      <button type="button" class="filter" data-tag={tag} aria-pressed="false">{tag}</button>
    ))}
  </div>

  <div class="count" id="posts-count" aria-live="polite">{posts.length} posts</div>

  <div class="list" id="posts-list">
    {posts.map((p) => <PostRow post={p} maxTags={4} />)}
    <div class="row-empty" id="posts-empty" hidden>No posts with that tag.</div>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const initialTag = params.get("tag") ?? "all";

  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const rows = document.querySelectorAll<HTMLElement>("#posts-list .row");
  const countEl = document.getElementById("posts-count");
  const emptyEl = document.getElementById("posts-empty");

  function filterByTag(tag: string) {
    let visible = 0;
    rows.forEach((row) => {
      const tags: string[] = JSON.parse(row.dataset.tags ?? "[]");
      const show = tag === "all" || tags.includes(tag);
      row.hidden = !show;
      if (show) visible++;
    });

    buttons.forEach((btn) => {
      const on = btn.dataset.tag === tag;
      btn.classList.toggle("on", on);
      btn.setAttribute("aria-pressed", String(on));
    });

    if (emptyEl) emptyEl.hidden = visible > 0;
    if (countEl) {
      countEl.textContent =
        tag === "all" ? `${visible} posts` : `${visible} post${visible === 1 ? "" : "s"} tagged ${tag}`;
    }
  }

  filterByTag(initialTag);

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tag ?? "all";
      filterByTag(tag);
      const url = new URL(window.location.href);
      if (tag === "all") url.searchParams.delete("tag");
      else url.searchParams.set("tag", tag);
      history.replaceState(null, "", url.toString());
    });
  });
</script>
